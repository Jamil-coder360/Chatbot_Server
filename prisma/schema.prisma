generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Contents {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  termsAndCondition String
  privacyPolicy     String
  refundPolicy      String
  shippingPolicy    String
  aboutUs           String
  location          String
  copyRight         String
  footerText        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contents")
}

model User {
  id                   String  @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  email                String  @unique
  password             String
  needToPasswordChange Boolean @default(false)
  status               Status  @default(ACTIVE)
  role                 Role    @default(USER)
  profile              String?
  location             String?
  customerId           String?
  phoneNumber          String?

  expiredAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  verification  Verification?
  notification  Notification[]
  deviceHistory DeviceHistory[]
  participant  Participant[]
  sender Message[] @relation("sentMessage")
  reciver Message[] @relation("reciveMessage")
}

model DeviceHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  ip        String?
  browser   String?
  os        String?
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Verification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @unique @db.ObjectId
  otp       Int
  expiredAt DateTime?
  status    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  reciverId   String   @db.ObjectId
  referenceId String   @db.ObjectId
  message     String
  description String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Chat{
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId 
  status Chat_Status @default(Active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant Participant[]
  messages    Message[]
}

model Participant{
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  chatId  String @unique @db.ObjectId
  userId String @db.ObjectId

  chat  Chat @relation(fields: [chatId],references: [id])
  user User @relation(fields: [userId], references: [id])

}

model Message{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  chatId String @db.ObjectId
  text String?
  imgUrl String?
  isSeen Boolean @default(false)
  reciverId String @db.ObjectId
  senderId  String @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   chat  Chat @relation(fields: [chatId],references: [id])
   reciver User @relation("reciveMessage",fields: [reciverId], references: [id])
   sender User @relation("sentMessage",fields: [senderId], references: [id])
}

enum Chat_Status {
  Block
  Active

}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  USER
  SUPERADMIN
  SubADMIN
}
